# Chave do OpenRouter (obrigatória para chamadas reais aos modelos)
OPENROUTER_API_KEY=your_api_key_here

# Cabeçalhos opcionais recomendados pelo OpenRouter
OPENROUTER_HTTP_REFERER=https://github.com/yourusername/poc_java_ia_safeguard-prompt-injection
OPENROUTER_X_TITLE=IA Devs - Guardrails

# Mantidos iguais ao exemplo JavaScript original
OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-7b-instruct
OPENROUTER_GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
TEMPERATURE=0.7
MAX_TOKENS=1000

# Por padrão o modo seguro fica ligado.
GUARDRAILS_ENABLED=true

# MCP Filesystem. O projeto fixa a mesma versão usada pelo material original.
MCP_NPX_COMMAND=npx
MCP_FILESYSTEM_PACKAGE=@modelcontextprotocol/server-filesystem@2026.1.14
MCP_LOG_EVENTS=false
